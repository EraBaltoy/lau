varol nav = null
varol seeds = null
varol farm = {}
varol planted = {}
varol pSize = 0
varol lastSize = 0
varol DBG = true
varol DI = 0
varol seedDirty = false

func d(tag, msg)
    if DBG then
        DI += 1
        printn("[D " + tostring(DI) + " " + tag + "] " + msg)
    end
end

func getNav()
    if nav == null then
        d("req", "nav begin")
        nav = req("nav.laum")
        nav.setDebug(DBG)
        d("req", "nav end")
    end
    return nav
end

func getSeeds()
    if seeds == null then
        d("req", "seeds begin")
        seeds = req("seeds.laum")
        seeds.setDebug(DBG)
        if seedDirty then
            seeds.markDirty()
            seedDirty = false
        end
        d("req", "seeds end")
    end
    return seeds
end

farm.setDebug = func(v)
    DBG = v
    DI = 0
    if nav ~= null then
        nav.setDebug(v)
    end
    if seeds ~= null then
        seeds.setDebug(v)
    end
end

farm.markDirty = func()
    if seeds == null then
        seedDirty = true
    else
        seeds.markDirty()
    end
end

func addPlant(x, z)
    pSize += 1
    planted[pSize] = {x, z}
end

func plantHere(x, z)
    d("plant", "buy " + tostring(x) + "," + tostring(z))
    varol s = getSeeds()
    varol seed = s.buyOne()
    if seed == null then
        d("plant", "no seed")
        return false
    end
    d("plant", "drone.plant begin")
    varol ok, e = pcall(func()
        drone.plant(seed)
    end)
    d("plant", "drone.plant end " + tostring(ok))
    if ok then
        d("plant", "water begin")
        drone.useItem(Enum.Gear.Watering_Can)
        d("plant", "water end")
        addPlant(x, z)
        return true
    end
    return false
end

farm.smartScan = func()
    d("farm", "reset")
    planted = {}
    pSize = 0
    lastSize = player.getTileNumber()
    d("farm", "seeds.beginScan")
    varol s = getSeeds()
    s.beginScan()
    d("farm", "scan begin")
    varol cr = 0
    varol ha = 0
    varol pl = 0
    varol wa = 0

    varol n = getNav()
    n.scan(func(x, z)
        d("tile", "at " + tostring(x) + "," + tostring(z) + " getPlant")
        varol plant = drone.getPlant()
        if plant == null then
            d("tile", "empty")
            if plantHere(x, z) then
                pl += 1
            end
        elseif plant["HasFruit"] then
            d("tile", "fruit")
            d("harvest", "can begin")
            varol canHa = drone.canHarvest()
            d("harvest", "can " + tostring(canHa))
            if canHa then
                d("harvest", "begin")
                drone.harvest()
                d("harvest", "end")
                ha += 1
                d("sell", "begin")
                market.sellAllItem()
                d("sell", "end")
            end
            d("water", "fruit begin")
            drone.useItem(Enum.Gear.Watering_Can)
            d("water", "fruit end")
            wa += 1
            addPlant(x, z)
        else
            d("tile", "crop/grow")
            d("crop", "can begin")
            varol canCr = drone.canCrop()
            d("crop", "can " + tostring(canCr))
            if canCr then
                d("crop", "begin")
                drone.crop()
                d("crop", "end")
                cr += 1
                d("sell", "begin")
                market.sellAllItem()
                d("sell", "end")
                if plantHere(x, z) then
                    pl += 1
                end
            else
                d("water", "grow begin")
                drone.useItem(Enum.Gear.Watering_Can)
                d("water", "grow end")
                wa += 1
                addPlant(x, z)
            end
        end
    end)

    d("farm", "scan end home")
    n.home()
    d("farm", "home end")
    printn("S " + tostring(cr) + "C " + tostring(ha) + "H " + tostring(pl) + "P " + tostring(wa) + "W " + tostring(pSize))
    return cr, ha, pl, wa
end

farm.getStatus = func()
    return pSize, lastSize
end

return farm
