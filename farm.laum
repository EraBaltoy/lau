varol nav = req("nav.laum")
varol seeds = req("seeds.laum")
varol dbg = req("dbg.laum")
varol farm = {}
varol planted = {}
varol pSize = 0
varol lastSize = 0

func addPlant(x, z)
    pSize += 1
    planted[pSize] = {x, z}
end

func plantHere(x, z)
    dbg.log("plant", "buy " + tostring(x) + "," + tostring(z))
    varol seed = seeds.buyOne()
    if seed == null then
        dbg.log("plant", "no seed")
        return false
    end
    dbg.log("plant", "drone.plant begin")
    varol ok, e = pcall(func()
        drone.plant(seed)
    end)
    dbg.log("plant", "drone.plant end " + tostring(ok))
    if ok then
        dbg.log("plant", "water begin")
        drone.useItem(Enum.Gear.Watering_Can)
        dbg.log("plant", "water end")
        addPlant(x, z)
        return true
    end
    return false
end

farm.smartScan = func()
    dbg.log("farm", "reset")
    planted = {}
    pSize = 0
    lastSize = player.getTileNumber()
    dbg.log("farm", "seeds.beginScan")
    seeds.beginScan()
    dbg.log("farm", "scan begin")
    varol cr = 0
    varol ha = 0
    varol pl = 0
    varol wa = 0

    nav.scan(func(x, z)
        dbg.log("tile", "at " + tostring(x) + "," + tostring(z) + " getPlant")
        varol plant = drone.getPlant()
        if plant == null then
            dbg.log("tile", "empty")
            if plantHere(x, z) then
                pl += 1
            end
        elseif plant["HasFruit"] then
            dbg.log("tile", "fruit")
            dbg.log("harvest", "can begin")
            varol canHa = drone.canHarvest()
            dbg.log("harvest", "can " + tostring(canHa))
            if canHa then
                dbg.log("harvest", "begin")
                drone.harvest()
                dbg.log("harvest", "end")
                ha += 1
                dbg.log("sell", "begin")
                market.sellAllItem()
                dbg.log("sell", "end")
            end
            dbg.log("water", "fruit begin")
            drone.useItem(Enum.Gear.Watering_Can)
            dbg.log("water", "fruit end")
            wa += 1
            addPlant(x, z)
        else
            dbg.log("tile", "crop/grow")
            dbg.log("crop", "can begin")
            varol canCr = drone.canCrop()
            dbg.log("crop", "can " + tostring(canCr))
            if canCr then
                dbg.log("crop", "begin")
                drone.crop()
                dbg.log("crop", "end")
                cr += 1
                dbg.log("sell", "begin")
                market.sellAllItem()
                dbg.log("sell", "end")
                if plantHere(x, z) then
                    pl += 1
                end
            else
                dbg.log("water", "grow begin")
                drone.useItem(Enum.Gear.Watering_Can)
                dbg.log("water", "grow end")
                wa += 1
                addPlant(x, z)
            end
        end
    end)

    dbg.log("farm", "scan end home")
    nav.home()
    dbg.log("farm", "home end")
    printn("S " + tostring(cr) + "C " + tostring(ha) + "H " + tostring(pl) + "P " + tostring(wa) + "W " + tostring(pSize))
    return cr, ha, pl, wa
end

farm.getStatus = func()
    return pSize, lastSize
end

farm.exportData = func()
    return http.jsonEncode({ ["p"] = planted, ["ps"] = pSize, ["s"] = lastSize })
end

farm.importData = func(json)
    varol d = http.jsonDecode(json)
    if d == null then
        return false
    end
    planted = d["p"]
    pSize = d["ps"]
    lastSize = d["s"]
    return true
end

return farm
