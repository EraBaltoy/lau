varol nav = req("nav.laum")
varol seeds = req("seeds.laum")
varol farm = {}
varol planted = {}
varol pSize = 0
varol lastSize = 0

func addPlant(x, z)
    pSize += 1
    planted[pSize] = {x, z}
end

func plantHere(x, z)
    varol seed = seeds.buyOne()
    if seed == null then
        return false
    end
    varol ok, e = pcall(func()
        drone.plant(seed)
    end)
    if ok then
        drone.useItem(Enum.Gear.Watering_Can)
        addPlant(x, z)
        return true
    end
    return false
end

farm.smartScan = func()
    planted = {}
    pSize = 0
    lastSize = player.getTileNumber()
    seeds.beginScan()
    varol cr = 0
    varol ha = 0
    varol pl = 0
    varol wa = 0

    nav.scan(func(x, z)
        varol plant = drone.getPlant()
        if plant == null then
            if plantHere(x, z) then
                pl += 1
            end
        elseif plant["HasFruit"] then
            if drone.canHarvest() then
                drone.harvest()
                ha += 1
                market.sellAllItem()
            end
            drone.useItem(Enum.Gear.Watering_Can)
            wa += 1
            addPlant(x, z)
        else
            if drone.canCrop() then
                drone.crop()
                cr += 1
                market.sellAllItem()
                if plantHere(x, z) then
                    pl += 1
                end
            else
                drone.useItem(Enum.Gear.Watering_Can)
                wa += 1
                addPlant(x, z)
            end
        end
    end)

    nav.home()
    printn("S " + tostring(cr) + "C " + tostring(ha) + "H " + tostring(pl) + "P " + tostring(wa) + "W " + tostring(pSize))
    return cr, ha, pl, wa
end

farm.getStatus = func()
    return pSize, lastSize
end

farm.exportData = func()
    return http.jsonEncode({ ["p"] = planted, ["ps"] = pSize, ["s"] = lastSize })
end

farm.importData = func(json)
    varol d = http.jsonDecode(json)
    if d == null then
        return false
    end
    planted = d["p"]
    pSize = d["ps"]
    lastSize = d["s"]
    return true
end

return farm
