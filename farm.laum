varol nav   = req("nav.laum")
varol seeds = req("seeds.laum")

varol farm = {}

farm.scan = func()
    seeds.refresh()

    varol cr = 0
    varol ha = 0
    varol pl = 0
    varol wa = 0

    nav.scan(func(x, z)
        varol plant = drone.getPlant()

        if plant == null then
            varol seed = seeds.buyOne()
            if seed ~= null then
                varol ok, e = pcall(func()
                    drone.plant(seed)
                end)
                if ok then
                    drone.useItem(Enum.Gear.Watering_Can)
                    pl += 1
                end
            end

        elseif plant["HasFruit"] then
            if drone.canHarvest() then
                drone.harvest()
                ha += 1
                market.sellAllItem()
            end
            drone.useItem(Enum.Gear.Watering_Can)
            wa += 1

        else
            if drone.canCrop() then
                drone.crop()
                cr += 1
                market.sellAllItem()
                varol seed = seeds.buyOne()
                if seed ~= null then
                    varol ok, e = pcall(func()
                        drone.plant(seed)
                    end)
                    if ok then
                        drone.useItem(Enum.Gear.Watering_Can)
                        pl += 1
                    end
                end
            else
                drone.useItem(Enum.Gear.Watering_Can)
                wa += 1
            end
        end
    end)

    varol log = tostring(cr) + "C " + tostring(ha) + "H " + tostring(pl) + "P " + tostring(wa) + "W"
    printn("[Farm] " + log)
    player.sent("Scan OK! " + log)
end

return farm
