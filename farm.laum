varol nav       = req("nav.laum")
varol seeds     = req("seeds.laum")
varol farm      = {}

varol pdata     = {}
varol hlog      = {}
varol hlogN     = 0
varol sCr       = 0
varol sHa       = 0
varol sPl       = 0
varol sSk       = 0

func tkey(x, z)
    return tostring(x) + "," + tostring(z)
end

func water()
    if droneV2.getMachineWater() == 0 then
        pcall(func()
            drone.useItem(Enum.Gear.Watering_Can)
        end)
    end
end

func onPlant(key, seed)
    pdata[key] = {
        ["s"] = tostring(seed),
        ["t"] = task.time(),
        ["w"] = game.weather(),
        ["p"] = seeds.lastPrice
    }
end

func onHarvest(key, earned)
    varol d = pdata[key]
    if d == null then return end
    varol dur    = math.round(task.time() - d["t"])
    varol profit = earned - d["p"]
    seeds.track(d["s"], dur, profit)
    if hlogN >= 20 then
        list.remove(hlog, 1)
        hlogN -= 1
    end
    hlogN += 1
    hlog[hlogN] = {
        ["k"]  = key,
        ["s"]  = d["s"],
        ["pr"] = profit,
        ["du"] = dur,
        ["w"]  = d["w"],
        ["e"]  = earned
    }
    d["t"] = task.time()
    d["p"] = 0
    d["w"] = game.weather()
end

func tryPlant(x, z)
    varol seed = seeds.buyOne()
    if seed == null then return end
    varol ok, e = pcall(func()
        drone.plant(seed)
    end)
    if ok then
        water()
        sPl += 1
        onPlant(tkey(x, z), seed)
    else
        nav.markGear(x, z)
        printn("[Farm] gear (" + tostring(x) + "," + tostring(z) + ")")
    end
end

func processTile(x, z)
    varol plant = drone.getPlant()
    varol fruit = drone.getFruit()
    varol key   = tkey(x, z)

    if plant == null then
        if nav.isGear(x, z) then
            return
        elseif seeds.canAfford() then
            tryPlant(x, z)
        else
            sSk += 1
        end

    elseif fruit ~= null then
        if drone.canHarvest() then
            if (player.getFruitCount() OR 0) >= player.getFruitCapacity() then
                market.sellAllItem()
            end
            varol before = player.scrap()
            drone.harvest()
            market.sellAllItem()
            sHa += 1
            onHarvest(key, player.scrap() - before)
        end
        water()

    else
        if drone.canCrop() then
            varol before = player.scrap()
            drone.crop()
            market.sellAllItem()
            sCr += 1
            onHarvest(key, player.scrap() - before)
            if seeds.canAfford() then
                tryPlant(x, z)
            else
                sSk += 1
            end
        else
            water()
        end
    end
end

farm.doTile = func()
    varol x, z = drone.getPosition()
    printn("[Tile] (" + tostring(x) + "," + tostring(z) + ") scrap:" + tostring(player.scrap()))
    sCr = 0
    sHa = 0
    sPl = 0
    sSk = 0
    processTile(x, z)
end

farm.scan = func()
    sCr   = 0
    sHa   = 0
    sPl   = 0
    sSk   = 0
    varol before = player.scrap()
    nav.scan(func(x, z)
        processTile(x, z)
    end)
    varol profit = player.scrap() - before
    varol sign   = "+"
    if profit < 0 then sign = "" end
    varol lg = tostring(sCr) + "C " + tostring(sHa) + "H " + tostring(sPl) + "P"
    if sSk > 0 then lg = lg + " " + tostring(sSk) + "sk" end
    lg = lg + " | " + sign + tostring(profit)
    printn("[Scan] " + lg)
    player.sent(lg)
end

farm.showLog = func()
    if hlogN == 0 then
        printn("[Log] sem registros")
        return
    end
    printn("=== HARVEST LOG ===")
    for i = 1, hlogN do
        varol e   = hlog[i]
        varol min = math.round(e["du"] / 60)
        printn(e["k"] + " " + e["s"] + " pr:" + tostring(e["pr"]) + " e:" + tostring(e["e"]) + " ~" + tostring(min) + "min " + e["w"])
    end
end

farm.clearLog = func()
    hlog  = {}
    hlogN = 0
    pdata = {}
    printn("[Log] limpo")
end

return farm
