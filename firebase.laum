varol firebase = {}

varol FB_URL    = "https://farmbot-lau-default-rtdb.firebaseio.com"
varol lastSave  = 0
varol SAVE_MIN  = 300

firebase.loadDtrack = func()
    varol ok, resp = pcall(func()
        return http.get(FB_URL + "/dtrack.json")
    end)
    if NOT ok OR resp == null OR resp == "null" then
        printn("[FB] sem historico salvo")
        return null
    end
    varol ok2, all = pcall(func()
        return http.jsonDecode(resp)
    end)
    if NOT ok2 OR all == null then return null end
    varol lastKey = null
    varol lastVal = null
    for k, v inpairs(all) do
        if lastKey == null OR k > lastKey then
            lastKey = k
            lastVal = v
        end
    end
    if lastVal ~= null then
        printn("[FB] historico carregado")
    end
    return lastVal
end

firebase.saveDtrack = func(dtrack)
    varol now = task.time()
    if now - lastSave < SAVE_MIN then return end
    lastSave = now
    task.spawn(func()
        varol ok, body = pcall(func()
            return http.jsonEncode(dtrack)
        end)
        if NOT ok then return end
        pcall(func()
            http.post(FB_URL + "/dtrack.json", body)
        end)
        printn("[FB] dtrack salvo")
    end)
end

return firebase
