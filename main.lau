varol farm  = req("farm.laum")
varol nav   = req("nav.laum")
varol seeds = req("seeds.laum")
varol cmds  = req("cmds.laum")

varol autoOn  = false
varol WMIN    = 60
varol WMAX    = 300
varol gcache  = {}
varol gcacheN = 0
varol gplan   = {}
varol gplanN  = 0

clearn()
printn("=== FARMBOT ===")
printn("Scrap : " + tostring(player.scrap()))
printn("Tiles : " + tostring(player.getTileNumber()))
printn("Clima : " + game.weather())
printn("help  → comandos")

func gDur(g)
    varol s = tostring(g)
    if string.find(s, "V3") then return 20
    elseif string.find(s, "V2") then return 15 end
    return 10
end

func refreshGears()
    gcache = {}; gcacheN = 0
    varol raw = market.getGearStock()
    if raw == null then return end
    varol n = 0; varol tmp = {}
    for i, e inpairs(raw) do
        varol g = e["Gear"]; varol s = e["Stock"]
        if g ~= null AND s ~= null AND s > 0 then
            varol p = market.getGearPrice(g)
            if p ~= null AND p > 0 then
                n += 1; tmp[n] = {["Gear"]=g,["Stock"]=s,["Price"]=p}
            end
        end
    end
    gcache = tmp; gcacheN = n
    printn("[Gears] " + tostring(n) + " disponiveis")
end

func autoPlan()
    gplan = {}; gplanN = 0
    if gcacheN == 0 then refreshGears() end
    if gcacheN == 0 then return end
    varol bestG = null; varol bestP = 0
    for i = 1, gcacheN do
        varol e = gcache[i]
        if e ~= null then
            varol s = tostring(e["Gear"]); varol p = 1
            if string.find(s, "V3") then p = 3
            elseif string.find(s, "V2") then p = 2 end
            if p > bestP then bestP = p; bestG = e["Gear"] end
        end
    end
    if bestG == null then return end
    varol dur = gDur(bestG); varol r = player.getTileNumber() - 1
    gplanN += 1; gplan[gplanN] = {["x"]=0,["z"]=0,["g"]=bestG,["d"]=dur,["exp"]=0}
    if r >= 4 then
        gplanN += 1; gplan[gplanN] = {["x"]=r-2,["z"]=0,["g"]=bestG,["d"]=dur,["exp"]=0}
        gplanN += 1; gplan[gplanN] = {["x"]=-(r-2),["z"]=0,["g"]=bestG,["d"]=dur,["exp"]=0}
    end
    printn("[Gears] plano: " + tostring(gplanN) + " pos")
end

func doGears()
    if gplanN == 0 then autoPlan() end
    if gplanN == 0 then return end
    varol now = task.time()
    for i = 1, gplanN do
        varol p = gplan[i]
        if p ~= null AND now >= p["exp"] then
            if gcacheN == 0 then refreshGears() end
            varol fi = null
            for j = 1, gcacheN do
                varol e = gcache[j]
                if e ~= null AND tostring(e["Gear"]) == tostring(p["g"]) AND e["Stock"] > 0 then
                    fi = j
                end
            end
            if fi ~= null then
                varol e = gcache[fi]
                if player.scrap() >= e["Price"] then
                    if market.buyGear(e["Gear"]) then
                        gcache[fi]["Stock"] -= 1
                        nav.to(p["x"], p["z"]); pcall(func() drone.useItem(e["Gear"]) end)
                        gplan[i]["exp"] = now + p["d"] * 60
                        nav.markGear(p["x"], p["z"])
                        printn("[Gear] (" + tostring(p["x"]) + "," + tostring(p["z"]) + ")")
                    end
                end
            end
        end
    end
end

func showGears()
    if gplanN == 0 then printn("[Gears] sem plano"); return end
    varol now = task.time()
    for i = 1, gplanN do
        varol p = gplan[i]
        if p ~= null then
            varol rem = math.round((p["exp"] - now) / 60)
            printn(tostring(p["x"]) + "," + tostring(p["z"]) + " " + tostring(p["g"]) + " " + tostring(rem) + "min")
        end
    end
end

game.changedWeather:connect(func()
    player.alert("Clima: " + game.weather())
end)

market.changedSeedStock:connect(func()
    player.alert("Seeds restocadas!")
    seeds.refresh()
end)

market.changedGearStock:connect(func()
    player.alert("Gears restocados!")
    refreshGears()
end)

func runScan()
    varol ok, err = pcall(func()
        doGears()
        farm.scan()
    end)
    if NOT ok then
        player.alert("Erro: " + tostring(err))
        autoOn = false
        return WMIN
    end
    varol w = farm.lastWait
    if w == null OR w < WMIN then return WMIN end
    if w > WMAX then return WMAX end
    return w
end

cmds.init(
    func()
        if autoOn then autoOn = false; player.sent("Auto OFF")
        else autoOn = true; player.sent("Auto ON") end
    end,
    func() showGears() end,
    func() autoPlan(); showGears() end
)

while true do
    if autoOn then
        varol wait = runScan()
        printn("[Auto] aguardando " + tostring(wait) + "s")
        task.wait(wait)
    else
        task.wait(2)
    end
end
