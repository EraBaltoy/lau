varol farm  = req("farm.laum")
varol nav   = req("nav.laum")
varol seeds = req("seeds.laum")
varol cmds  = req("cmds.laum")

varol autoOn = false
varol WMIN   = 60
varol WMAX   = 600

clearn()
printn("=== FARMBOT ===")
printn("Scrap : " + tostring(player.scrap()))
printn("Tiles : " + tostring(player.getTileNumber()))
printn("Clima : " + game.weather())
printn("help  → comandos")

func refreshGears()
    nav.gcache  = {}
    nav.gcacheN = 0
    varol raw = market.getGearStock()
    if raw == null then return end
    varol n   = 0
    varol tmp = {}
    for i, e inpairs(raw) do
        varol g = e["Gear"]
        varol s = e["Stock"]
        if g ~= null AND s ~= null AND s > 0 then
            varol p = market.getGearPrice(g)
            if p ~= null AND p > 0 then
                n += 1
                tmp[n] = {["Gear"]=g,["Stock"]=s,["Price"]=p}
            end
        end
    end
    nav.gcache  = tmp
    nav.gcacheN = n
    printn("[Gears] " + tostring(n) + " disponiveis")
end

func doGears()
    if nav.gplanN == 0 then
        refreshGears()
        nav.autoPlan()
    end
    if nav.gplanN == 0 then return end
    varol now = task.time()
    for i = 1, nav.gplanN do
        varol p = nav.gplan[i]
        if p ~= null AND now >= p["exp"] then
            if nav.gcacheN == 0 then refreshGears() end
            varol fi = null
            for j = 1, nav.gcacheN do
                varol e = nav.gcache[j]
                if e ~= null AND tostring(e["Gear"]) == tostring(p["g"]) AND e["Stock"] > 0 then
                    fi = j
                end
            end
            if fi ~= null then
                varol e = nav.gcache[fi]
                if player.scrap() >= e["Price"] then
                    if market.buyGear(e["Gear"]) then
                        nav.gcache[fi]["Stock"] -= 1
                        nav.to(p["x"], p["z"])
                        pcall(func() drone.useItem(e["Gear"]) end)
                        nav.gplan[i]["exp"] = now + p["d"] * 60
                        nav.markGear(p["x"], p["z"])
                        printn("[Gear] (" + tostring(p["x"]) + "," + tostring(p["z"]) + ")")
                    end
                end
            end
        end
    end
end

game.changedWeather:connect(func()
    player.alert("Clima: " + game.weather())
end)

market.changedSeedStock:connect(func()
    player.alert("Seeds restocadas!")
    seeds.refresh()
end)

market.changedGearStock:connect(func()
    player.alert("Gears restocados!")
    refreshGears()
    nav.autoPlan()
end)

func runScan()
    varol t0 = task.time()
    varol ok, err = pcall(func()
        doGears()
        farm.scan()
    end)
    if NOT ok then
        player.alert("Erro: " + tostring(err))
        autoOn = false
        return WMIN
    end
    varol elapsed = task.time() - t0
    varol w = farm.lastWait
    if w == null then w = WMIN end
    w -= elapsed
    if w < WMIN then return WMIN end
    if w > WMAX then return WMAX end
    return w
end

cmds.init(func()
    if autoOn then
        autoOn = false
        player.sent("Auto OFF")
    else
        autoOn = true
        player.sent("Auto ON")
    end
end)

while true do
    if autoOn then
        varol wait = runScan()
        printn("[Auto] aguardando " + tostring(wait) + "s")
        task.wait(wait)
    else
        task.wait(2)
    end
end
