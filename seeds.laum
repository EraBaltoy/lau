varol seeds = {}
varol scache = {}
varol scacheN = 0
varol dirty = false
varol budget = 0

seeds.markDirty = func()
    dirty = true
end

func sortDesc(lst, n)
    for i = 1, n - 1 do
        for j = 1, n - i do
            if lst[j]["Price"] < lst[j + 1]["Price"] then
                varol t = lst[j]
                lst[j] = lst[j + 1]
                lst[j + 1] = t
            end
        end
    end
end

seeds.refresh = func()
    scache = {}
    scacheN = 0
    varol raw = market.getSeedStock()
    if raw == null then
        return
    end
    for i, e inpairs(raw) do
        varol seed = e["Seed"]
        varol stock = e["Stock"]
        if seed ~= null AND stock ~= null AND stock > 0 then
            varol price = market.getSeedPrice(seed)
            if price ~= null AND price > 0 then
                scacheN += 1
                scache[scacheN] = { ["Seed"] = seed, ["Stock"] = stock, ["Price"] = price }
            end
        end
    end
    if scacheN > 1 then
        sortDesc(scache, scacheN)
    end
end

seeds.beginScan = func()
    seeds.refresh()
    dirty = false
    budget = player.scrap()
end

seeds.buyOne = func()
    if scacheN == 0 then
        return null
    end
    for i = 1, scacheN do
        varol e = scache[i]
        if e ~= null AND e["Stock"] > 0 AND e["Price"] <= budget then
            if market.buySeed(e["Seed"]) then
                scache[i]["Stock"] -= 1
                budget -= e["Price"]
                return e["Seed"]
            end
        end
    end
    return null
end

return seeds
