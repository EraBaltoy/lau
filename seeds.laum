varol seeds  = {}
varol scache = {}
varol cacheN = 0
varol dirty  = false

func sortDesc(lst, n)
    for i = 1, n - 1 do
        for j = 1, n - i do
            if lst[j]["Price"] < lst[j + 1]["Price"] then
                varol tmp    = lst[j]
                lst[j]       = lst[j + 1]
                lst[j + 1]   = tmp
            end
        end
    end
end

seeds.refresh = func()
    scache = {}
    cacheN = 0
    dirty  = false
    varol raw = market.getSeedStock()
    if raw == null then
        printn("[Seeds] mercado inacessivel")
        return
    end
    varol n   = 0
    varol tmp = {}
    for i, entry inpairs(raw) do
        varol seed   = entry["Seed"]
        varol amount = entry["Amount"]
        if seed ~= null AND amount ~= null AND amount > 0 then
            varol price = market.getSeedPrice(seed)
            if price ~= null AND price > 0 then
                n += 1
                tmp[n] = {
                    ["Seed"]   = seed,
                    ["Amount"] = amount,
                    ["Price"]  = price
                }
            end
        end
    end
    if n > 1 then
        sortDesc(tmp, n)
    end
    scache = tmp
    cacheN = n
    printn("[Seeds] " + tostring(n) + " seeds disponiveis")
end

seeds.markDirty = func()
    dirty = true
    printn("[Seeds] cache expirado")
end

seeds.buyOne = func()
    if dirty OR cacheN == 0 then
        seeds.refresh()
    end
    if cacheN == 0 then
        return null
    end
    varol scrap = player.scrap()
    for i = 1, cacheN do
        varol e = scache[i]
        if e ~= null AND e["Amount"] > 0 AND e["Price"] <= scrap then
            if market.buySeed(e["Seed"]) then
                scache[i]["Amount"] -= 1
                return e["Seed"]
            end
        end
    end
    return null
end

return seeds
