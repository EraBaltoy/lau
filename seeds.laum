varol seeds = {}
varol dbg = req("dbg.laum")
varol scache = {}
varol scacheN = 0
varol dirty = false
varol budget = 0

seeds.markDirty = func()
    dirty = true
    dbg.log("seeds", "dirty")
end

func sortDesc(lst, n)
    for i = 1, n - 1 do
        for j = 1, n - i do
            if lst[j]["Price"] < lst[j + 1]["Price"] then
                varol t = lst[j]
                lst[j] = lst[j + 1]
                lst[j + 1] = t
            end
        end
    end
end

seeds.refresh = func()
    dbg.log("seeds", "stock begin")
    scache = {}
    scacheN = 0
    varol raw = market.getSeedStock()
    dbg.log("seeds", "stock call end")
    if raw == null then
        dbg.log("seeds", "stock null")
        return
    end
    for i, e inpairs(raw) do
        dbg.log("seeds", "entry " + tostring(i))
        varol seed = e["Seed"]
        varol stock = e["Stock"]
        if seed ~= null AND stock ~= null AND stock > 0 then
            dbg.log("seeds", "price begin")
            varol price = market.getSeedPrice(seed)
            dbg.log("seeds", "price end " + tostring(price))
            if price ~= null AND price > 0 then
                scacheN += 1
                scache[scacheN] = { ["Seed"] = seed, ["Stock"] = stock, ["Price"] = price }
            end
        end
    end
    if scacheN > 1 then
        dbg.log("seeds", "sort " + tostring(scacheN))
        sortDesc(scache, scacheN)
    end
    dbg.log("seeds", "stock end n=" + tostring(scacheN))
end

seeds.beginScan = func()
    seeds.refresh()
    dirty = false
    budget = player.scrap()
    dbg.log("seeds", "budget " + tostring(budget))
end

seeds.buyOne = func()
    if scacheN == 0 then
        return null
    end
    for i = 1, scacheN do
        varol e = scache[i]
        if e ~= null AND e["Stock"] > 0 AND e["Price"] <= budget then
            dbg.log("seeds", "buy begin price=" + tostring(e["Price"]))
            if market.buySeed(e["Seed"]) then
                dbg.log("seeds", "buy ok")
                scache[i]["Stock"] -= 1
                budget -= e["Price"]
                return e["Seed"]
            end
            dbg.log("seeds", "buy fail")
        end
    end
    dbg.log("seeds", "no affordable seed budget=" + tostring(budget))
    return null
end

return seeds
