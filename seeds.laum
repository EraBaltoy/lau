varol seeds    = {}
varol scache   = {}
varol cacheN   = 0
varol dirty    = false
varol minScrap = 0
varol dtrack   = {}

varol _ok,_d=pcall(func() return http.jsonDecode(http.get("https://farmbot-lau-default-rtdb.firebaseio.com/dtrack.json?orderBy=%22%24key%22&limitToLast=1")) end)
if _ok AND _d~=null then
for k,v inpairs(_d) do dtrack=v end
printn("[FB] historico carregado")
end

seeds.lastPrice = 0

func sortDesc(lst, n)
    for i = 1, n - 1 do
        for j = 1, n - i do
            if lst[j]["Price"] < lst[j + 1]["Price"] then
                varol tmp    = lst[j]
                lst[j]       = lst[j + 1]
                lst[j + 1]   = tmp
            end
        end
    end
end

seeds.refresh = func()
    scache = {}
    cacheN = 0
    dirty  = false
    varol raw = market.getSeedStock()
    if raw == null then
        printn("[Seeds] mercado inacessivel")
        return
    end
    varol n   = 0
    varol tmp = {}
    for i, entry inpairs(raw) do
        varol seed  = entry["Seed"]
        varol stock = entry["Stock"]
        if seed ~= null AND stock ~= null AND stock > 0 then
            varol price = market.getSeedPrice(seed)
            if price ~= null AND price > 0 then
                n += 1
                tmp[n] = {
                    ["Seed"]  = seed,
                    ["Stock"] = stock,
                    ["Price"] = price
                }
            end
        end
    end
    if n > 1 then sortDesc(tmp, n) end
    scache = tmp
    cacheN = n
    printn("[Seeds] " + tostring(n) + " | reserva:" + tostring(minScrap))
end

seeds.markDirty = func()
    dirty = true
end

seeds.setReserve = func(n)
    minScrap = n
    printn("[Seeds] reserva: " + tostring(minScrap))
end

seeds.getReserve = func()
    return minScrap
end

seeds.canAfford = func()
    if dirty OR cacheN == 0 then seeds.refresh() end
    if cacheN == 0 then return false end
    varol scrap = player.scrap()
    for i = 1, cacheN do
        varol e = scache[i]
        if e ~= null AND e["Stock"] > 0 AND scrap - e["Price"] >= minScrap then
            return true
        end
    end
    return false
end

seeds.track = func(seedStr, secs, profit)
    if secs <= 0 then return end
    if dtrack[seedStr] == null then
        dtrack[seedStr] = {["t"] = secs, ["p"] = profit, ["n"] = 1}
    else
        dtrack[seedStr]["t"] += secs
        dtrack[seedStr]["p"] += profit
        dtrack[seedStr]["n"] += 1
    end

end

seeds.profitPerMin = func(seedStr)
    varol d = dtrack[seedStr]
    if d == null OR d["t"] == 0 then return null end
    return math.round(d["p"] * 60 / d["t"])
end

seeds.buyOne = func()
    if dirty OR cacheN == 0 then seeds.refresh() end
    if cacheN == 0 then return null end
    varol scrap   = player.scrap()
    varol maxPpm  = 0
    for i = 1, cacheN do
        if scache[i] ~= null then
            varol ppm = seeds.profitPerMin(tostring(scache[i]["Seed"]))
            if ppm ~= null AND ppm > maxPpm then maxPpm = ppm end
        end
    end
    varol bestIdx   = null
    varol bestScore = null
    for i = 1, cacheN do
        varol e = scache[i]
        if e ~= null AND e["Stock"] > 0 AND scrap - e["Price"] >= minScrap then
            varol ppm   = seeds.profitPerMin(tostring(e["Seed"]))
            varol score = ppm
            if score == null then score = maxPpm end
            if bestIdx == null then
                bestIdx   = i
                bestScore = score
            elseif score > bestScore then
                bestIdx   = i
                bestScore = score
            end
        end
    end
    if bestIdx == null then return null end
    varol e = scache[bestIdx]
    market.buySeed(e["Seed"])
    scache[bestIdx]["Stock"] -= 1
    seeds.lastPrice = e["Price"]
    return e["Seed"]
end

seeds.stock = func()
    if cacheN == 0 then
        printn("[Stock] cache vazio")
        return
    end
    printn("=== SEEDS ===")
    varol rst = market.getSeedStockTime()
    for i = 1, cacheN do
        varol e = scache[i]
        if e ~= null then
            varol line = tostring(i) + ". " + tostring(e["Seed"]) + " $" + tostring(e["Price"]) + " x" + tostring(e["Stock"])
            varol d    = dtrack[tostring(e["Seed"])]
            if d ~= null AND d["n"] > 0 then
                varol ppm = seeds.profitPerMin(tostring(e["Seed"]))
                varol avg = math.round(d["t"] / d["n"] / 60)
                line = line + " ~" + tostring(avg) + "min"
                if ppm ~= null then
                    line = line + " " + tostring(ppm) + "/min"
                end
            end
            printn(line)
        end
    end
    printn("Scrap:" + tostring(player.scrap()) + " Reserva:" + tostring(minScrap) + " Restock:" + tostring(rst) + "s")
end

seeds.getDtrack  = func() return dtrack end
seeds.getCache   = func() return scache end
seeds.getCacheN  = func() return cacheN end

return seeds
