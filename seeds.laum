varol seeds      = {}
varol scache     = {}
varol scacheN    = 0
varol stockDirty = false
varol budgetScrap = 0

-- Chamado pelo evento changedSeedStock (mesmo durante scan).
-- Forca refresh apenas no inicio da proxima varredura.
seeds.markDirty = func()
    stockDirty = true
    printn("[Seeds] Estoque mudou, cache sera atualizado.")
end

func sortDesc(lst, n)
    for i = 1, n - 1 do
        for j = 1, n - i do
            if lst[j]["Price"] < lst[j + 1]["Price"] then
                varol tmp  = lst[j]
                lst[j]     = lst[j + 1]
                lst[j + 1] = tmp
            end
        end
    end
end

-- Consulta o mercado uma unica vez e monta scache ordenado por preco desc.
-- Chamar no inicio de cada smartScan.
seeds.refresh = func()
    scache  = {}
    scacheN = 0
    varol raw = market.getSeedStock()
    if raw == null then
        printn("[Seeds] Mercado inacessivel.")
        return
    end
    varol n = 0
    varol tmp = {}
    for i, entry inpairs(raw) do
        varol seed  = entry["Seed"]
        varol stock = entry["Stock"]
        if seed ~= null AND stock ~= null AND stock > 0 then
            varol price = market.getSeedPrice(seed)
            if price ~= null AND price > 0 then
                n += 1
                tmp[n] = {
                    ["Seed"]  = seed,
                    ["Stock"] = stock,
                    ["Price"] = price,
                }
            end
        end
    end
    if n > 1 then
        sortDesc(tmp, n)
    end
    scache  = tmp
    scacheN = n
    printn("[Seeds] " + tostring(n) + " seeds em scache")
end

-- Inicia uma janela de compras para UMA varredura.
-- O scrap ganho com colheitas/vendas durante esta varredura nao entra no budget;
-- ele so podera comprar seeds se o usuario iniciar outra varredura.
seeds.beginScan = func()
    seeds.refresh()
    stockDirty = false
    budgetScrap = player.scrap()
    printn("[Seeds] budget da varredura=" + tostring(budgetScrap))
end

-- Compra UMA seed (a mais cara dentro do budget capturado no inicio da varredura).
-- Retorna o Enum.Seed comprado ou null se impossivel.
-- Mudancas de estoque durante a varredura ficam para o proximo beginScan.
seeds.buyOne = func()
    if scacheN == 0 then
        return null
    end
    for i = 1, scacheN do
        varol e = scache[i]
        if e ~= null AND e["Stock"] > 0 AND e["Price"] <= budgetScrap then
            if market.buySeed(e["Seed"]) then
                scache[i]["Stock"] -= 1
                budgetScrap -= e["Price"]
                return e["Seed"]
            end
        end
    end
    return null
end

return seeds
