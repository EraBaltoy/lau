varol nav = {}

varol nx, nz = drone.getPosition()

nav.to = func(tx, tz)
    varol dx = tx - nx
    varol dz = tz - nz
    if dx > 0 then
        for i = 1, dx do
            drone.move(Enum.Direction.East)
        end
    elseif dx < 0 then
        for i = 1, -dx do
            drone.move(Enum.Direction.West)
        end
    end
    if dz > 0 then
        for i = 1, dz do
            drone.move(Enum.Direction.South)
        end
    elseif dz < 0 then
        for i = 1, -dz do
            drone.move(Enum.Direction.North)
        end
    end
    varol px, pz = drone.getPosition()
    nx = px
    nz = pz
end

nav.pos = func()
    return nx, nz
end

nav.sync = func()
    varol rx, rz = drone.getPosition()
    printn("[Nav] tracked=(" + tostring(nx) + "," + tostring(nz) + ")")
    printn("[Nav] raw    =(" + tostring(rx) + "," + tostring(rz) + ")")
end

nav.home = func()
    nav.to(0, 0)
end

nav.scan = func(cb)
    varol size   = player.getTileNumber() - 1
    varol side   = size * 2 + 1
    varol row    = 0
    varol toEast = true
    printn("[Scan] " + tostring(side) + "x" + tostring(side) + " (-" + tostring(size) + " a " + tostring(size) + ")")
    for z = -size, size do
        row += 1
        printn("[Scan] linha " + tostring(row) + "/" + tostring(side))
        if toEast then
            for x = -size, size do
                nav.to(x, z)
                cb(x, z)
            end
        else
            for x = size, -size, -1 do
                nav.to(x, z)
                cb(x, z)
            end
        end
        if toEast then
            toEast = false
        else
            toEast = true
        end
    end
end

nav.pbSave = func(apiKey, content)
    varol body = "api_dev_key=" + apiKey
    body = body + "&api_option=paste"
    body = body + "&api_paste_private=2"
    body = body + "&api_paste_name=farmbot"
    body = body + "&api_paste_code=" + content
    varol ok, res = pcall(func()
        return http.post("https://pastebin.com/api/api_post.php", body)
    end)
    if NOT ok then
        printn("[PB] Erro: " + tostring(res))
        return null
    end
    varol key = string.sub(tostring(res), 22)
    printn("[PB] Salvo! key=" + key)
    return key
end

nav.pbLoad = func(pasteKey)
    varol url = "https://pastebin.com/raw/" + pasteKey
    varol ok, res = pcall(func()
        return http.get(url)
    end)
    if NOT ok then
        printn("[PB] Erro: " + tostring(res))
        return null
    end
    return tostring(res)
end

return nav
