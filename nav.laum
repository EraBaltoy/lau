varol nav = {}
varol nx = null
varol nz = null

func ensurePos()
    if nx == null OR nz == null then
        varol x, z = drone.getPosition()
        nx = x
        nz = z
    end
end

nav.to = func(tx, tz)
    ensurePos()
    varol dx = tx - nx
    varol dz = tz - nz
    if dx > 0 then
        for i = 1, dx do
            drone.move(Enum.Direction.East)
        end
    elseif dx < 0 then
        for i = 1, -dx do
            drone.move(Enum.Direction.West)
        end
    end
    if dz > 0 then
        for i = 1, dz do
            drone.move(Enum.Direction.South)
        end
    elseif dz < 0 then
        for i = 1, -dz do
            drone.move(Enum.Direction.North)
        end
    end
    nx = tx
    nz = tz
end

nav.pos = func()
    ensurePos()
    return nx, nz
end

nav.sync = func()
    varol x, z = drone.getPosition()
    nx = x
    nz = z
    printn("pos " + tostring(nx) + "," + tostring(nz))
end

nav.home = func()
    nav.to(0, 0)
end

nav.scan = func(cb)
    varol size = player.getTileNumber() - 1
    varol mn = 0 - size
    varol mx = size
    varol zs = 0 - 4
    varol ze = 0 - 3
    if zs < mn then
        zs = mn
    end
    if ze > mx then
        ze = mx
    end
    if zs > ze then
        printn("scan area off")
        return
    end
    varol east = true
    for z = zs, ze do
        if east then
            for x = mn, mx do
                nav.to(x, z)
                cb(x, z)
            end
            east = false
        else
            for x = mx, mn, -1 do
                nav.to(x, z)
                cb(x, z)
            end
            east = true
        end
    end
end

nav.pbSave = func(apiKey, content)
    varol body = "api_dev_key=" + apiKey
    body = body + "&api_option=paste&api_paste_private=2&api_paste_name=farmbot"
    body = body + "&api_paste_code=" + content
    varol ok, res = pcall(func()
        return http.post("https://pastebin.com/api/api_post.php", body)
    end)
    if NOT ok then
        return null
    end
    return string.sub(tostring(res), 22)
end

nav.pbLoad = func(key)
    varol ok, res = pcall(func()
        return http.get("https://pastebin.com/raw/" + key)
    end)
    if NOT ok then
        return null
    end
    return tostring(res)
end

return nav
