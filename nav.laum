varol nav = {}
varol nx = null
varol nz = null
varol DBG = true
varol DI = 0

func d(tag, msg)
    if DBG then
        DI += 1
        printn("[D " + tostring(DI) + " " + tag + "] " + msg)
    end
end

nav.setDebug = func(v)
    DBG = v
    DI = 0
end

func ensurePos()
    if nx == null OR nz == null then
        d("nav", "getPosition begin")
        varol x, z = drone.getPosition()
        d("nav", "getPosition end")
        nx = x
        nz = z
    end
end

nav.to = func(tx, tz)
    d("nav", "to " + tostring(tx) + "," + tostring(tz))
    ensurePos()
    varol dx = tx - nx
    varol dz = tz - nz
    if dx > 0 then
        for i = 1, dx do
            d("move", "E")
            drone.move(Enum.Direction.East)
        end
    elseif dx < 0 then
        for i = 1, -dx do
            d("move", "W")
            drone.move(Enum.Direction.West)
        end
    end
    if dz > 0 then
        for i = 1, dz do
            d("move", "S")
            drone.move(Enum.Direction.South)
        end
    elseif dz < 0 then
        for i = 1, -dz do
            d("move", "N")
            drone.move(Enum.Direction.North)
        end
    end
    nx = tx
    nz = tz
    d("nav", "at " + tostring(nx) + "," + tostring(nz))
end

nav.pos = func()
    ensurePos()
    return nx, nz
end

nav.sync = func()
    d("nav", "sync begin")
    varol x, z = drone.getPosition()
    d("nav", "sync end")
    nx = x
    nz = z
    printn("pos " + tostring(nx) + "," + tostring(nz))
end

nav.home = func()
    nav.to(0, 0)
end

nav.scan = func(cb)
    d("scan", "bounds begin")
    varol size = player.getTileNumber() - 1
    d("scan", "tileNumber end size=" + tostring(size))
    varol mn = 0 - size
    varol mx = size
    varol zs = 0 - 4
    varol ze = 0 - 3
    if zs < mn then
        zs = mn
    end
    if ze > mx then
        ze = mx
    end
    if zs > ze then
        d("scan", "area off")
        printn("scan area off")
        return
    end
    d("scan", "area x=" + tostring(mn) + ".." + tostring(mx) + " z=" + tostring(zs) + ".." + tostring(ze))
    varol east = true
    for z = zs, ze do
        d("scan", "row z=" + tostring(z))
        if east then
            for x = mn, mx do
                nav.to(x, z)
                cb(x, z)
            end
            east = false
        else
            for x = mx, mn, -1 do
                nav.to(x, z)
                cb(x, z)
            end
            east = true
        end
    end
    d("scan", "done")
end

return nav
