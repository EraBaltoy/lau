varol nav     = {}
varol nx, nz  = drone.getPosition()
varol gTiles  = {}

nav.gcache  = {}
nav.gcacheN = 0
nav.gplan   = {}
nav.gplanN  = 0

nav.pos  = func() return nx, nz end
nav.posX = func() return nx end
nav.posZ = func() return nz end

nav.sync = func()
    varol x, z = drone.getPosition()
    nx = x
    nz = z
    printn("[Nav] (" + tostring(nx) + "," + tostring(nz) + ")")
end

nav.to = func(tx, tz)
    varol dx = tx - nx
    varol dz = tz - nz
    if dx > 0 then
        for i = 1, dx do drone.move(Enum.Direction.East) end
    elseif dx < 0 then
        for i = 1, -dx do drone.move(Enum.Direction.West) end
    end
    if dz > 0 then
        for i = 1, dz do drone.move(Enum.Direction.South) end
    elseif dz < 0 then
        for i = 1, -dz do drone.move(Enum.Direction.North) end
    end
    nx = tx
    nz = tz
end

nav.home = func() nav.to(0, 0) end

nav.isGear = func(x, z)
    return gTiles[tostring(x) + "," + tostring(z)] == true
end

nav.markGear = func(x, z)
    gTiles[tostring(x) + "," + tostring(z)] = true
end

nav.clearGears = func()
    gTiles = {}
    printn("[Nav] gears limpo")
end

nav.isCovered = func(x, z)
    varol now = task.time()
    for i = 1, nav.gplanN do
        varol p = nav.gplan[i]
        if p ~= null AND now < p["exp"] then
            varol rng = nav.gRange(p["g"])
            if math.abs(x - p["x"]) <= rng AND math.abs(z - p["z"]) <= rng then
                return true
            end
        end
    end
    return false
end

nav.gDur = func(g)
    varol s = tostring(g)
    if string.find(s, "V3") then
        return 20
    elseif string.find(s, "V2") then
        return 15
    end
    return 10
end

nav.gRange = func(g)
    varol s = tostring(g)
    if string.find(s, "V3") then
        return 3
    elseif string.find(s, "V2") then
        return 2
    end
    return 1
end

nav.autoPlan = func()
    nav.gplan  = {}
    nav.gplanN = 0
    if nav.gcacheN == 0 then return end
    varol bestG = null
    varol bestP = 0
    for i = 1, nav.gcacheN do
        varol e = nav.gcache[i]
        if e ~= null then
            varol s = tostring(e["Gear"])
            varol p = 1
            if string.find(s, "V3") then
                p = 3
            elseif string.find(s, "V2") then
                p = 2
            end
            if p > bestP then
                bestP = p
                bestG = e["Gear"]
            end
        end
    end
    if bestG == null then return end
    varol dur  = nav.gDur(bestG)
    varol rng  = nav.gRange(bestG)
    varol step = rng * 2
    varol r    = player.getTileNumber() - 1
    varol xp   = 0 - r + rng
    while xp <= r - rng do
        varol zp = 0 - r + rng
        while zp <= r - rng do
            nav.gplanN += 1
            nav.gplan[nav.gplanN] = {["x"]=xp,["z"]=zp,["g"]=bestG,["d"]=dur,["exp"]=0}
            zp += step
        end
        xp += step
    end
    printn("[Gears] plano: " + tostring(nav.gplanN) + " posicoes")
end

varol _col = 0

func _ct(x, z)
    nav.to(x, z)
    varol pl = drone.getPlant()
    if pl ~= null then
        varol fruit = drone.getFruit()
        if fruit ~= null AND drone.canHarvest() then
            if (player.getFruitCount() OR 0) >= player.getFruitCapacity() then
                market.sellAllItem()
            end
            drone.harvest()
            _col += 1
        elseif fruit == null AND drone.canCrop() then
            drone.crop()
            _col += 1
        end
    end
end

nav.collect = func()
    varol r    = player.getTileNumber() - 1
    varol min  = 0 - r
    varol max  = r
    varol east = true
    _col = 0
    for z = min, max do
        if east then
            for x = min, max do _ct(x, z) end
        else
            for x = max, min, -1 do _ct(x, z) end
        end
        if east then east = false else east = true end
    end
    market.sellAllItem()
    nav.home()
    printn("[Col] " + tostring(_col) + " coletados")
    return _col
end

nav.scan = func(cb)
    nav.sync()
    varol r    = player.getTileNumber() - 1
    varol min  = 0 - r
    varol max  = r
    varol east = true
    varol rows = max - min + 1
    varol row  = 0
    for z = min, max do
        row += 1
        printn("[Scan] " + tostring(row) + "/" + tostring(rows) + " z=" + tostring(z))
        if east then
            for x = min, max do
                nav.to(x, z)
                cb(x, z)
            end
        else
            for x = max, min, -1 do
                nav.to(x, z)
                cb(x, z)
            end
        end
        if east then east = false else east = true end
    end
    nav.home()
    printn("[Scan] concluido")
end

return nav
