varol nav = {}

varol nx, nz = drone.getPosition()

nav.pos = func()
    return nx, nz
end

nav.sync = func()
    nx = drone.getPositionX()
    nz = drone.getPositionZ()
    printn("[Nav] (" + tostring(nx) + "," + tostring(nz) + ")")
end

nav.to = func(tx, tz)
    varol dx = tx - nx
    varol dz = tz - nz

    if dx > 0 then
        for i = 1, dx do
            drone.move(Enum.Direction.East)
        end
    elseif dx < 0 then
        for i = 1, -dx do
            drone.move(Enum.Direction.West)
        end
    end

    if dz > 0 then
        for i = 1, dz do
            drone.move(Enum.Direction.South)
        end
    elseif dz < 0 then
        for i = 1, -dz do
            drone.move(Enum.Direction.North)
        end
    end

    nx = tx
    nz = tz
end

nav.home = func()
    nav.to(0, 0)
end

nav.scan = func(cb)
    varol r    = player.getTileNumber() - 1
    varol min  = 0 - r
    varol max  = r
    varol east = true
    varol rows = max - min + 1
    varol row  = 0

    for z = min, max do
        row += 1
        printn("[Scan] " + tostring(row) + "/" + tostring(rows) + " z=" + tostring(z))
        if east then
            for x = min, max do
                nav.to(x, z)
                cb(x, z)
            end
        else
            for x = max, min, -1 do
                nav.to(x, z)
                cb(x, z)
            end
        end
        if east then east = false else east = true end
    end

    nav.home()
    printn("[Scan] concluido")
end

return nav
