varol cmds = {}
varol nav = null
varol farm = null
varol seeds = null
varol PB_KEY = ""
varol PB_PASTE = ""

func getSeeds()
    if seeds == null then
        seeds = req("seeds.laum")
    end
    return seeds
end

func getFarm()
    if farm == null then
        farm = req("farm.laum")
    end
    return farm
end

func getNav()
    if nav == null then
        nav = req("nav.laum")
    end
    return nav
end

func status()
    varol f = getFarm()
    varol ps, ls = f.getStatus()
    varol cur = player.getTileNumber()
    varol size = cur - 1
    varol total = (size * 2 + 1) * (size * 2 + 1)
    varol pb = "OFF"
    if PB_KEY ~= "" then
        pb = "ON"
        if PB_PASTE ~= "" then
            pb = pb + " " + PB_PASTE
        end
    end
    printn("Farm " + tostring(size) + " tiles " + tostring(total))
    printn("P " + tostring(ps) + " scan " + tostring(ls) + " PB " + pb)
    if cur ~= ls AND ls ~= 0 then
        printn("WARN remap: smart")
    end
end

func help()
    printn("smart|sell|save|load k|pbkey k")
    printn("status|home|pos|sync|inv")
end

cmds.init = func()
    market.changedSeedStock:connect(func()
        if seeds ~= null then
            seeds.markDirty()
        end
    end)

    player.chatted:connect(func(msg)
        msg = string.lower(msg)
        if msg == "smart" then
            player.sent("scan...")
            varol f = getFarm()
            varol cr, ha, pl, wa = f.smartScan()
            player.sent("OK " + tostring(cr) + "C " + tostring(ha) + "H " + tostring(pl) + "P " + tostring(wa) + "W")
        elseif msg == "sell" then
            market.sellAllItem()
            player.sent("OK")
        elseif msg == "save" then
            if PB_KEY == "" then
                player.sent("pbkey <key>")
            else
                varol f = getFarm()
                varol n = getNav()
                varol json = f.exportData()
                varol key = n.pbSave(PB_KEY, json)
                if key ~= null then
                    PB_PASTE = key
                    player.sent("save " + key)
                else
                    player.sent("save err")
                end
            end
        elseif string.sub(msg, 1, 5) == "load " then
            varol key = string.sub(msg, 6)
            varol n = getNav()
            varol json = n.pbLoad(key)
            if json ~= null then
                varol f = getFarm()
                if f.importData(json) then
                    PB_PASTE = key
                    player.sent("load OK")
                else
                    player.sent("load err")
                end
            else
                player.sent("load err")
            end
        elseif string.sub(msg, 1, 6) == "pbkey " then
            PB_KEY = string.sub(msg, 7)
            player.sent("pb OK")
        elseif msg == "status" then
            status()
        elseif msg == "home" then
            varol n = getNav()
            n.home()
        elseif msg == "sync" then
            varol n = getNav()
            n.sync()
        elseif msg == "pos" then
            varol n = getNav()
            varol x, z = n.pos()
            player.sent("(" + tostring(x) + "," + tostring(z) + ")")
        elseif msg == "inv" then
            printn("F " + tostring(player.getFruitCount()) + "/" + tostring(player.getFruitCapacity()) + " T " + tostring(player.getInventorySize()))
        elseif msg == "help" then
            help()
        end
    end)

    printn("Bot: smart")
end

return cmds
