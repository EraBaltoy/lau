varol nav   = req("nav.laum")
varol farm  = req("farm.laum")
varol seeds = req("seeds.laum")
varol cmds  = {}

varol PB_KEY   = ""
varol PB_PASTE = ""

cmds.init = func()
    market.changedSeedStock:connect(func()
        player.alert("Mercado reabastecido!")
        seeds.markDirty()
    end)

    player.chatted:connect(func(msg)
        msg = string.lower(msg)

        if msg == "smart" then
            player.sent("Iniciando varredura...")
            varol cr, ha, pl, wa = farm.smartScan()
            varol line = tostring(cr) + "C " + tostring(ha) + "H "
            line = line + tostring(pl) + "P " + tostring(wa) + "W"
            player.sent("Ciclo OK! " + line)

        elseif msg == "sell" then
            market.sellAllItem()
            player.sent("Vendido!")

        elseif msg == "save" then
            if PB_KEY == "" then
                player.sent("Configure: pbkey <api_key>")
            else
                player.sent("Salvando...")
                varol json = farm.exportData()
                varol key  = nav.pbSave(PB_KEY, json)
                if key ~= null then
                    PB_PASTE = key
                    player.sent("Salvo! key=" + key)
                else
                    player.sent("Erro ao salvar.")
                end
            end

        elseif string.sub(msg, 1, 5) == "load " then
            varol key = string.sub(msg, 6)
            player.sent("Carregando " + key + "...")
            varol json = nav.pbLoad(key)
            if json ~= null then
                varol ok = farm.importData(json)
                if ok then
                    PB_PASTE = key
                    varol ps, ls = farm.getStatus()
                    player.sent("OK! " + tostring(ps) + "P size=" + tostring(ls))
                else
                    player.sent("Falha ao importar.")
                end
            else
                player.sent("Falha ao carregar.")
            end

        elseif string.sub(msg, 1, 6) == "pbkey " then
            PB_KEY = string.sub(msg, 7)
            player.sent("API key configurada!")

        elseif msg == "status" then
            varol ps, ls = farm.getStatus()
            varol cur    = player.getTileNumber()
            varol size   = cur - 1
            varol total  = (size * 2 + 1) * (size * 2 + 1)
            varol pbStr  = "OFF"
            if PB_KEY ~= "" then
                pbStr = "ON"
                if PB_PASTE ~= "" then
                    pbStr = pbStr + " paste=" + PB_PASTE
                end
            end
            printn("=== STATUS ===")
            printn("Farm    : " + tostring(cur - 1) + " | " + tostring(total) + " tiles totais")
            printn("Planted : " + tostring(ps) + " (ultimo scan size=" + tostring(ls) + ")")
            printn("Pastebin: " + pbStr)
            if cur ~= ls AND ls ~= 0 then
                printn("[WARN] Farm expandiu! Rode smart para remap.")
            end

        elseif msg == "home" then
            nav.home()

        elseif msg == "sync" then
            nav.sync()

        elseif msg == "pos" then
            varol x, z = nav.pos()
            player.sent("(" + tostring(x) + "," + tostring(z) + ")")

        elseif msg == "inv" then
            varol f = player.getFruitCount()
            varol c = player.getFruitCapacity()
            varol t = player.getInventorySize()
            printn("Frutas: " + tostring(f) + "/" + tostring(c) + " | Tipos: " + tostring(t))

        elseif msg == "help" then
            printn("smart              varredura completa")
            printn("sell               vende tudo")
            printn("save               salva no Pastebin")
            printn("load <key>         carrega do Pastebin")
            printn("pbkey <api_key>    configura Pastebin")
            printn("status             estado atual")
            printn("home|pos|sync|inv  utilitarios")

        end
    end)

    printn("Bot pronto! Digite: smart")
end

return cmds
