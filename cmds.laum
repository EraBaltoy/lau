varol cmds = {}
varol DBG = true
varol DI = 0
varol nav = null
varol farm = null
varol PB_KEY = ""
varol PB_PASTE = ""

func d(tag, msg)
    if DBG then
        DI += 1
        printn("[D " + tostring(DI) + " " + tag + "] " + msg)
    end
end

func setDbg(v)
    DBG = v
    DI = 0
    if farm ~= null then
        farm.setDebug(v)
    end
    if nav ~= null then
        nav.setDebug(v)
    end
end

func getFarm()
    if farm == null then
        d("req", "farm begin")
        farm = req("farm.laum")
        farm.setDebug(DBG)
        d("req", "farm end")
    end
    return farm
end

func getNav()
    if nav == null then
        d("req", "nav begin")
        nav = req("nav.laum")
        nav.setDebug(DBG)
        d("req", "nav end")
    end
    return nav
end

func status()
    varol f = getFarm()
    varol ps, ls = f.getStatus()
    varol cur = player.getTileNumber()
    varol size = cur - 1
    varol total = (size * 2 + 1) * (size * 2 + 1)
    varol pb = "OFF"
    if PB_KEY ~= "" then
        pb = "ON"
        if PB_PASTE ~= "" then
            pb = pb + " " + PB_PASTE
        end
    end
    printn("Farm " + tostring(size) + " tiles " + tostring(total))
    printn("P " + tostring(ps) + " scan " + tostring(ls) + " PB " + pb)
    if cur ~= ls AND ls ~= 0 then
        printn("WARN remap: smart")
    end
end

func help()
    printn("smart|sell|save|load k|pbkey k")
    printn("status|home|pos|sync|inv|debug on|off")
end

cmds.init = func()
    market.changedSeedStock:connect(func()
        if farm ~= null then
            farm.markDirty()
        end
    end)

    player.chatted:connect(func(msg)
        msg = string.lower(msg)
        if msg == "smart" then
            DI = 0
            d("smart", "start")
            player.sent("scan...")
            d("cmd", "get farm")
            varol f = getFarm()
            d("cmd", "farm.smartScan")
            varol cr, ha, pl, wa = f.smartScan()
            d("cmd", "smart done")
            player.sent("OK " + tostring(cr) + "C " + tostring(ha) + "H " + tostring(pl) + "P " + tostring(wa) + "W")
        elseif msg == "sell" then
            DI = 0
            d("sell", "start")
            d("sell", "market.sellAllItem begin")
            market.sellAllItem()
            d("sell", "market.sellAllItem end")
            player.sent("OK")
        elseif msg == "debug on" then
            setDbg(true)
            player.sent("debug on")
        elseif msg == "debug off" then
            setDbg(false)
            player.sent("debug off")
        elseif msg == "save" then
            if PB_KEY == "" then
                player.sent("pbkey <key>")
            else
                DI = 0
                d("save", "start")
                varol f = getFarm()
                varol n = getNav()
                d("save", "export")
                varol json = f.exportData()
                d("save", "pb post")
                varol key = n.pbSave(PB_KEY, json)
                if key ~= null then
                    PB_PASTE = key
                    player.sent("save " + key)
                else
                    player.sent("save err")
                end
            end
        elseif string.sub(msg, 1, 5) == "load " then
            DI = 0
            d("load", "start")
            varol key = string.sub(msg, 6)
            varol n = getNav()
            d("load", "pb get")
            varol json = n.pbLoad(key)
            if json ~= null then
                varol f = getFarm()
                d("load", "import")
                if f.importData(json) then
                    PB_PASTE = key
                    player.sent("load OK")
                else
                    player.sent("load err")
                end
            else
                player.sent("load err")
            end
        elseif string.sub(msg, 1, 6) == "pbkey " then
            PB_KEY = string.sub(msg, 7)
            player.sent("pb OK")
        elseif msg == "status" then
            d("cmd", "status")
            status()
        elseif msg == "home" then
            varol n = getNav()
            n.home()
        elseif msg == "sync" then
            varol n = getNav()
            n.sync()
        elseif msg == "pos" then
            varol n = getNav()
            varol x, z = n.pos()
            player.sent("(" + tostring(x) + "," + tostring(z) + ")")
        elseif msg == "inv" then
            printn("F " + tostring(player.getFruitCount()) + "/" + tostring(player.getFruitCapacity()) + " T " + tostring(player.getInventorySize()))
        elseif msg == "help" then
            help()
        end
    end)

    d("boot", "ready")
    printn("Bot: smart")
end

return cmds
