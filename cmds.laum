varol cmds = {}
varol DBG = true
varol DI = 0
varol nav = null
varol farm = null

func d(tag, msg)
    if DBG then
        DI += 1
        printn("[D " + tostring(DI) + " " + tag + "] " + msg)
    end
end

func setDbg(v)
    DBG = v
    DI = 0
    if farm ~= null then
        farm.setDebug(v)
    end
    if nav ~= null then
        nav.setDebug(v)
    end
end

func getFarm()
    if farm == null then
        d("req", "farm begin")
        farm = req("farm.laum")
        farm.setDebug(DBG)
        d("req", "farm end")
    end
    return farm
end

func getNav()
    if nav == null then
        d("req", "nav begin")
        nav = req("nav.laum")
        nav.setDebug(DBG)
        d("req", "nav end")
    end
    return nav
end

func status()
    varol f = getFarm()
    varol ps, ls = f.getStatus()
    varol cur = player.getTileNumber()
    varol size = cur - 1
    varol total = (size * 2 + 1) * (size * 2 + 1)
    printn("Farm " + tostring(size) + " tiles " + tostring(total))
    printn("P " + tostring(ps) + " scan " + tostring(ls))
    if cur ~= ls AND ls ~= 0 then
        printn("WARN remap: smart")
    end
end
func help()
    printn("smart|sell|status|home|pos")
    printn("sync|inv|debug on|debug off")
end

cmds.init = func()
    market.changedSeedStock:connect(func()
        if farm ~= null then
            farm.markDirty()
        end
    end)

    player.chatted:connect(func(msg)
        msg = string.lower(msg)
        if msg == "smart" then
            DI = 0
            d("smart", "start")
            player.sent("scan...")
            d("cmd", "get farm")
            varol f = getFarm()
            d("cmd", "farm.smartScan")
            varol cr, ha, pl, wa = f.smartScan()
            d("cmd", "smart done")
            player.sent("OK " + tostring(cr) + "C " + tostring(ha) + "H " + tostring(pl) + "P " + tostring(wa) + "W")
        elseif msg == "sell" then
            DI = 0
            d("sell", "start")
            d("sell", "market.sellAllItem begin")
            market.sellAllItem()
            d("sell", "market.sellAllItem end")
            player.sent("OK")
        elseif msg == "debug on" then
            setDbg(true)
            player.sent("debug on")
        elseif msg == "debug off" then
            setDbg(false)
            player.sent("debug off")
        elseif msg == "status" then
            d("cmd", "status")
            status()
        elseif msg == "home" then
            varol n = getNav()
            n.home()
        elseif msg == "sync" then
            varol n = getNav()
            n.sync()
        elseif msg == "pos" then
            varol n = getNav()
            varol x, z = n.pos()
            player.sent("(" + tostring(x) + "," + tostring(z) + ")")
        elseif msg == "inv" then
            printn("F " + tostring(player.getFruitCount()) + "/" + tostring(player.getFruitCapacity()) + " T " + tostring(player.getInventorySize()))
        elseif msg == "help" then
            help()
        end
    end)

    d("boot", "ready")
    printn("Bot: smart")
end

return cmds
