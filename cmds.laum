varol farm  = req("farm.laum")
varol nav   = req("nav.laum")
varol seeds = req("seeds.laum")

varol cmds = {}

cmds.showGears = func()
    if nav.gplanN == 0 then
        printn("[Gears] sem plano")
        return
    end
    varol now = task.time()
    for i = 1, nav.gplanN do
        varol p = nav.gplan[i]
        if p ~= null then
            varol rem = math.round((p["exp"] - now) / 60)
            printn(tostring(p["x"]) + "," + tostring(p["z"]) + " " + tostring(p["g"]) + " " + tostring(rem) + "min")
        end
    end
end

cmds.init = func(toggleAuto)
    player.chatted:connect(func(msg)
        msg = string.lower(msg)

        if msg == "auto" then
            toggleAuto()

        elseif msg == "tile" then
            farm.doTile()

        elseif msg == "scan" then
            player.sent("Scan iniciado...")
            varol ok, err = pcall(func()
                farm.scan()
            end)
            if NOT ok then
                player.alert("Erro: " + tostring(err))
            end

        elseif msg == "sell" then
            market.sellAllItem()
            player.sent("Vendido! Scrap: " + tostring(player.scrap()))

        elseif msg == "stock" then
            seeds.refresh()
            seeds.stock()

        elseif msg == "log" then
            farm.showLog()

        elseif msg == "clearlog" then
            farm.clearLog()

        elseif msg == "col" then
            varol ok, err = pcall(func() nav.collect() end)
            if NOT ok then player.alert("Erro: " + tostring(err)) end

        elseif msg == "gears" then
            cmds.showGears()

        elseif msg == "gplan" then
            nav.autoPlan()
            cmds.showGears()

        elseif msg == "clearmap" then
            nav.clearGears()

        elseif msg == "home" then
            nav.home()
            player.sent("Home!")

        elseif msg == "pos" then
            varol x, z = nav.pos()
            player.sent("(" + tostring(x) + "," + tostring(z) + ")")

        elseif msg == "sync" then
            nav.sync()
            player.sent("Sincronizado!")

        elseif msg == "inv" then
            varol f = player.getFruitCount()
            varol c = player.getFruitCapacity()
            varol t = player.getInventorySize()
            printn("Frutas: " + tostring(f) + "/" + tostring(c) + " | Itens: " + tostring(t))

        elseif string.sub(msg, 1, 8) == "reserve " then
            varol n = tonumber(string.sub(msg, 9))
            if n ~= null then
                seeds.setReserve(n)
                player.sent("Reserva: " + tostring(n))
            else
                player.alert("Uso: reserve <numero>")
            end

        elseif msg == "status" then
            varol t   = player.getTileNumber()
            varol sq  = (t * 2 - 1) * (t * 2 - 1)
            varol x, z = nav.pos()
            varol rst  = market.getSeedStockTime()
            varol lw   = farm.lastWait
            printn("=== STATUS ===")
            printn("Scrap   : " + tostring(player.scrap()))
            printn("Reserva : " + tostring(seeds.getReserve()))
            printn("Comprar : " + tostring(seeds.canAfford()))
            printn("Restock : " + tostring(rst) + "s")
            if lw ~= null then
                printn("Prox    : ~" + tostring(math.round(lw / 60)) + "min")
            end
            printn("Drone   : (" + tostring(x) + "," + tostring(z) + ")")
            printn("Tiles   : " + tostring(t) + " (" + tostring(sq) + " total)")
            printn("Clima   : " + game.weather())

        elseif msg == "help" then
            printn("auto           liga/desliga loop (scan completo)")
            printn("col            coleta apenas plantas prontas")
            printn("tile           processa tile atual")
            printn("scan           varre toda a fazenda")
            printn("sell           vende todos os itens")
            printn("stock          estoque + tempo medio de crescimento")
            printn("gears          mostra plano de gears atual")
            printn("gplan          gera novo plano de gears")
            printn("log            historico: profit/duracao/weather")
            printn("clearlog       limpa historico e rastreamento")
            printn("clearmap       reseta mapa de gears")
            printn("home/pos/sync  navegacao do drone")
            printn("inv            inventario")
            printn("reserve <n>    reserva minima de scrap")
            printn("status         estado completo")

        end
    end)
end

return cmds
